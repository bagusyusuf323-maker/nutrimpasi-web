---
import type { NotionPost } from '../lib/notion';

export interface Props {
  post: NotionPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;

// Format tanggal Indonesia
const formattedDate = new Date(post.date).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const primaryTag = post.tags && post.tags.length > 0 ? post.tags[0].name : 'MPASI Sehat';
---

<article class={`group flex flex-col bg-white rounded-3xl border border-brand-border/70 overflow-hidden shadow-soft hover:shadow-soft-hover transition-all duration-300 hover:-translate-y-1 ${featured ? 'md:grid md:grid-cols-2 md:gap-6' : ''}`}>
  <!-- Thumbnail Container -->
  <a href={`/blog/${post.slug}`} class="relative block overflow-hidden aspect-[16/10] bg-brand-secondary/30">
    <img
      src={post.cover}
      alt={`Foto ilustrasi untuk ${post.title}`}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-brand-text/30 via-transparent to-transparent opacity-60"></div>
    
    <!-- Primary Category Badge -->
    <span class="absolute top-4 left-4 inline-flex items-center px-3.5 py-1 rounded-full text-xs font-semibold bg-white/95 text-brand-primary shadow-sm backdrop-blur-sm">
      <span class="w-1.5 h-1.5 rounded-full bg-brand-primary mr-1.5"></span>
      {primaryTag}
    </span>
  </a>

  <!-- Content Section -->
  <div class="p-6 sm:p-7 flex flex-col flex-1 justify-between">
    <div>
      <!-- Meta Information (Date & Read Time) -->
      <div class="flex items-center gap-3 text-xs text-brand-text-muted mb-3 font-medium">
        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          {formattedDate}
        </span>
        <span>•</span>
        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          {post.readTime || '4 menit baca'}
        </span>
      </div>

      <!-- Title -->
      <h2 class="text-xl sm:text-2xl font-bold font-heading text-brand-text group-hover:text-brand-primary transition-colors line-clamp-2 mb-3 leading-snug">
        <a href={`/blog/${post.slug}`}>
          {post.title}
        </a>
      </h2>

      <!-- Excerpt -->
      <p class="text-sm sm:text-base text-brand-text-muted line-clamp-3 leading-relaxed mb-4">
        {post.excerpt}
      </p>
    </div>

    <!-- Read More Action -->
    <div class="pt-4 border-t border-brand-border/60 flex items-center justify-between">
      <span class="text-xs font-semibold text-brand-text/70">
        Oleh {post.author || 'Tim Ahli'}
      </span>
      <a
        href={`/blog/${post.slug}`}
        class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-primary group-hover:text-brand-primary-dark transition-all group-hover:translate-x-1"
        aria-label={`Baca selengkapnya artikel ${post.title}`}
      >
        <span>Baca Artikel</span>
        <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>
    </div>
  </div>
</article>
