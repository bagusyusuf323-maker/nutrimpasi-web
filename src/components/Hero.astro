---
---

<section class="relative overflow-hidden pt-10 pb-16 md:pt-16 md:pb-24 bg-gradient-to-b from-brand-secondary/30 via-brand-bg to-brand-bg">
  <!-- Decorative organic shapes in background -->
  <div class="absolute top-10 left-1/2 -translate-x-1/2 -z-10 w-[600px] h-[600px] bg-brand-primary/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-40 right-10 -z-10 w-72 h-72 bg-brand-accent/15 rounded-full blur-2xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copywriting & CTA (Cols 1-7) -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-6">
        
        <!-- Friendly Pill Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-brand-border shadow-sm text-xs sm:text-sm font-semibold text-brand-primary">
          <span class="flex h-2.5 w-2.5 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-accent opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-brand-accent"></span>
          </span>
          <span>Nutrisi Tepat 1.000 Hari Pertama Kehidupan</span>
        </div>

        <!-- Main H1 Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold font-heading text-brand-text leading-[1.15] tracking-tight">
          MPASI Sehat, Praktis, & Bergizi untuk Senyum Tumbuh Kembang Si Kecil
        </h1>

        <!-- Subheading Paragraph -->
        <p class="text-base sm:text-lg lg:text-xl text-brand-text-muted leading-relaxed max-w-2xl mx-auto lg:mx-0">
          Menu MPASI bergizi seimbang, higienis, dan 100% alami tanpa pengawet atau perasa buatan. Dibuat khusus membantu orang tua muda mendampingi kebutuhan nutrisi bayi usia 6–24 bulan dengan penuh ketenangan dan cinta.
        </p>

        <!-- CTA Buttons Group -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a
            href="#cta-section"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full font-bold text-base sm:text-lg text-brand-text bg-brand-accent hover:bg-[#FFA84D] shadow-warm transition-all duration-200 hover:-translate-y-1 active:translate-y-0"
          >
            <span>Pilih MPASI Sehat untuk Si Kecil</span>
            <svg class="w-5 h-5 text-brand-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href="/blog"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full font-bold text-base sm:text-lg text-brand-text bg-white hover:bg-brand-secondary/50 border border-brand-border shadow-sm transition-all duration-200 hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
            <span>Baca Panduan & Resep</span>
          </a>
        </div>

        <!-- Social Proof Stats -->
        <div class="pt-6 border-t border-brand-border/60 grid grid-cols-3 gap-4 max-w-lg mx-auto lg:mx-0">
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold font-heading text-brand-primary">10.000+</div>
            <div class="text-xs text-brand-text-muted font-medium mt-0.5">Ibu Muda Puas</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold font-heading text-brand-accent">100%</div>
            <div class="text-xs text-brand-text-muted font-medium mt-0.5">Bahan Alami & Organik</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold font-heading text-brand-coral">0%</div>
            <div class="text-xs text-brand-text-muted font-medium mt-0.5">Pengawet & MSG</div>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Hero Card & Baby Illustration (Cols 8-12) -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Main Visual Card -->
          <div class="relative rounded-4xl bg-white p-4 sm:p-5 border-2 border-brand-secondary shadow-soft">
            <div class="relative overflow-hidden rounded-3xl aspect-[4/3] bg-brand-secondary/30">
              <img
                src="https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?auto=format&fit=crop&w=1000&q=80"
                alt="Bayi ceria menyantap MPASI sehat bergizi"
                class="w-full h-full object-cover"
                loading="eager"
                fetchpriority="high"
                width="800"
                height="600"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
              
              <div class="absolute bottom-4 left-4 right-4 text-white">
                <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-brand-accent text-brand-text mb-1">
                  Menu Hari Ini
                </span>
                <p class="font-heading font-bold text-sm sm:text-base drop-shadow-sm">
                  Puree Daging Sapi & Labu Kuning Lembut (BB Booster)
                </p>
              </div>
            </div>

            <!-- Floating Badge 1: Nutrisi Seimbang -->
            <div class="absolute -top-5 -left-4 sm:-left-6 bg-white py-2.5 px-4 rounded-2xl shadow-soft border border-brand-border flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-brand-secondary flex items-center justify-center text-brand-accent">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold text-brand-text">Tekstur Sesuai Usia</p>
                <p class="text-[11px] text-brand-text-muted">6 bln • 9 bln • 12+ bln</p>
              </div>
            </div>

            <!-- Floating Badge 2: Anti GTM -->
            <div class="absolute -bottom-5 -right-4 sm:-right-6 bg-white py-2.5 px-4 rounded-2xl shadow-soft border border-brand-border flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-brand-primary/20 flex items-center justify-center text-brand-primary">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold text-brand-text">Solusi Anti GTM</p>
                <p class="text-[11px] text-brand-text-muted">Rasa Alami Disukai Anak</p>
              </div>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>
