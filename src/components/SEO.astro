---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'NutriMPASI - Panduan & Menu MPASI Sehat, Praktis, dan Bergizi untuk Bayi',
  description = 'Media edukasi MPASI terpercaya untuk orang tua modern. Temukan panduan usia, resep praktis, tips mengatasi GTM, dan rekomendasi menu bernutrisi tinggi.',
  image = 'https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?auto=format&fit=crop&w=1200&q=80',
  canonicalURL = Astro.url.href,
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'Tim NutriMPASI',
  tags = [],
  schema,
} = Astro.props;

const siteTitle = title.includes('NutriMPASI') ? title : `${title} | NutriMPASI`;
const siteUrl = Astro.site ? Astro.site.toString() : 'https://nutrimpasi.vercel.app';
const fullImageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).toString();

// Base Organization Schema
const defaultOrganizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'NutriMPASI',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description: 'Digital media dan panduan terpercaya pemenuhan nutrisi MPASI sehat untuk bayi Indonesia.',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+62-812-3456-7890',
    contactType: 'Customer Support',
  },
};

// Base WebSite Schema with SearchAction
const defaultWebsiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'NutriMPASI',
  url: siteUrl,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/blog?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const schemasToRender = schema
  ? (Array.isArray(schema) ? schema : [schema])
  : [defaultOrganizationSchema, defaultWebsiteSchema];
---

<!-- Essential Meta Tags -->
<title>{siteTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="theme-color" content="#4ABFCA" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:alt" content={siteTitle} />
<meta property="og:site_name" content="NutriMPASI" />
<meta property="og:locale" content="id_ID" />

<!-- Article Specific Meta Tags -->
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{type === 'article' && author && (
  <meta property="article:author" content={author} />
)}
{type === 'article' && tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@nutrimpasi" />
<meta name="twitter:creator" content="@nutrimpasi" />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />

<!-- Structured Data (JSON-LD) -->
{schemasToRender.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
