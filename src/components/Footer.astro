---
const currentYear = new Date().getFullYear();

const blogTopics = [
  'MPASI Sehat & Tumbuh Kembang Bayi',
  'Panduan MPASI sesuai usia',
  'Ide menu MPASI',
  'Nutrisi dan kebutuhan bayi',
  'Tips menghadapi GTM (Gerakan Tutup Mulut)',
  'Tips menyimpan dan menyiapkan MPASI',
];
---

<footer class="bg-white border-t border-brand-border/80 pt-16 pb-12 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 mb-12">
      
      <!-- Brand & About (Cols 1-5) -->
      <div class="lg:col-span-5 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-brand-primary flex items-center justify-center text-white shadow-soft">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v4m0 0a2 2 0 100-4 2 2 0 000 4zm-7 8c0 4.418 3.582 8 8 8s8-3.582 8-8H5z" />
            </svg>
          </div>
          <span class="text-2xl font-extrabold font-heading text-brand-text">
            Nutri<span class="text-brand-primary">MPASI</span>
          </span>
        </a>
        <p class="text-brand-text-muted text-sm sm:text-base leading-relaxed pr-4">
          Sahabat terpercaya orang tua muda dalam mendampingi 1.000 Hari Pertama Kehidupan si kecil. Menyajikan panduan nutrisi berbasis bukti sains dan resep MPASI lezat, praktis, bergizi, serta aman.
        </p>

        <!-- Social Icons -->
        <div class="flex items-center gap-3 pt-2">
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-brand-secondary/70 flex items-center justify-center text-brand-text hover:bg-brand-primary hover:text-white transition-colors" aria-label="Instagram NutriMPASI">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-brand-secondary/70 flex items-center justify-center text-brand-text hover:bg-brand-primary hover:text-white transition-colors" aria-label="TikTok NutriMPASI">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.525.02c1.31 0 2.59.39 3.67 1.12.35.24.67.52.95.83v4.61c-1.12-.66-2.42-1.02-3.75-1.03v7.35c0 3.26-2.65 5.9-5.91 5.9-3.26 0-5.91-2.64-5.91-5.9 0-3.26 2.65-5.91 5.91-5.91.43 0 .86.05 1.28.14V11.2c-.41-.12-.84-.18-1.28-.18-1.7 0-3.08 1.38-3.08 3.08s1.38 3.08 3.08 3.08 3.08-1.38 3.08-3.08V0l1.96.02z"/>
            </svg>
          </a>
          <a href="https://wa.me/6281234567890" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-brand-secondary/70 flex items-center justify-center text-brand-text hover:bg-[#25D366] hover:text-white transition-colors" aria-label="WhatsApp Tanya Konsultasi MPASI">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links (Cols 6-8) -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-base font-bold font-heading text-brand-text tracking-wide">
          Navigasi Cepat
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/" class="text-brand-text-muted hover:text-brand-primary transition-colors">Beranda</a>
          </li>
          <li>
            <a href="/about" class="text-brand-text-muted hover:text-brand-primary transition-colors">Tentang NutriMPASI</a>
          </li>
          <li>
            <a href="/blog" class="text-brand-text-muted hover:text-brand-primary transition-colors">Katalog Artikel & Resep</a>
          </li>
          <li>
            <a href="/#produk-section" class="text-brand-text-muted hover:text-brand-primary transition-colors">Varian Menu MPASI</a>
          </li>
          <li>
            <a href="/#faq-section" class="text-brand-text-muted hover:text-brand-primary transition-colors">Pertanyaan Umum (FAQ)</a>
          </li>
        </ul>
      </div>

      <!-- Topics / Categories (Cols 9-12) -->
      <div class="lg:col-span-4 space-y-4">
        <h3 class="text-base font-bold font-heading text-brand-text tracking-wide">
          Topik & Panduan Populer
        </h3>
        <div class="flex flex-wrap gap-2">
          {blogTopics.map((topic) => (
            <a
              href={`/blog?tag=${encodeURIComponent(topic)}`}
              class="inline-block px-3 py-1.5 rounded-full text-xs font-medium bg-brand-bg text-brand-text hover:bg-brand-secondary hover:text-brand-primary border border-brand-border/60 transition-colors"
            >
              {topic}
            </a>
          ))}
        </div>
      </div>

    </div>

    <!-- Health Disclaimer & Copyright -->
    <div class="border-t border-brand-border/60 pt-8 mt-6">
      <div class="p-4 rounded-2xl bg-brand-secondary/40 text-xs text-brand-text-muted leading-relaxed mb-6">
        <strong class="text-brand-text font-bold">Disclaimer Medis:</strong> Informasi dan resep yang disajikan di NutriMPASI dirancang untuk tujuan edukasi gizi dan gaya hidup sehat bayi. Selalu konsultasikan dengan dokter spesialis anak atau tenaga kesehatan terpercaya untuk kondisi medis spesifik, alergi, atau penanganan gangguan tumbuh kembang si kecil.
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-between text-xs text-brand-text-muted gap-4">
        <p>© {currentYear} NutriMPASI. Hak Cipta Dilindungi Undang-Undang.</p>
        <div class="flex items-center gap-6">
          <a href="/about" class="hover:text-brand-primary transition-colors">Kebijakan Privasi</a>
          <a href="/about" class="hover:text-brand-primary transition-colors">Syarat & Ketentuan</a>
          <a href="/sitemap-index.xml" class="hover:text-brand-primary transition-colors">Sitemap XML</a>
        </div>
      </div>
    </div>
  </div>
</footer>
