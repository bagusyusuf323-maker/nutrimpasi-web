---
const navLinks = [
  { name: 'Beranda', href: '/' },
  { name: 'Tentang Kami', href: '/about' },
  { name: 'Blog & Panduan', href: '/blog' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full bg-white/90 backdrop-blur-md border-b border-brand-border/60 transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-brand-primary rounded-2xl p-1" aria-label="NutriMPASI - Beranda">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-brand-primary to-brand-primary-dark flex items-center justify-center text-white shadow-soft group-hover:scale-105 transition-transform duration-200">
          <!-- Baby Bowl Icon -->
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v4m0 0a2 2 0 100-4 2 2 0 000 4zm-7 8c0 4.418 3.582 8 8 8s8-3.582 8-8H5z" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-2xl font-extrabold font-heading text-brand-text tracking-tight group-hover:text-brand-primary transition-colors">
            Nutri<span class="text-brand-primary">MPASI</span>
          </span>
          <span class="text-[10px] tracking-wider font-semibold text-brand-text-muted uppercase">
            Sahabat Tumbuh Kembang Bayi
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navLinks.map((link) => {
          const isActive = link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              class={`px-4 py-2 rounded-full text-sm font-semibold transition-all duration-200 ${
                isActive
                  ? 'text-brand-primary bg-brand-secondary/70 font-bold'
                  : 'text-brand-text hover:text-brand-primary hover:bg-brand-secondary/30'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Desktop CTA Button -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="/#cta-section"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full font-bold text-sm text-brand-text bg-brand-accent hover:bg-[#FFA84D] shadow-warm transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0"
        >
          <svg class="w-4 h-4 text-brand-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Pilih MPASI Sehat</span>
        </a>
      </div>

      <!-- Mobile Menu Hamburger Button -->
      <div class="flex md:hidden">
        <button
          type="button"
          id="mobile-menu-btn"
          class="p-2.5 rounded-2xl text-brand-text hover:text-brand-primary hover:bg-brand-secondary/40 focus:outline-none focus:ring-2 focus:ring-brand-primary"
          aria-label="Buka menu navigasi"
          aria-expanded="false"
        >
          <svg id="hamburger-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-brand-border/60 bg-white px-4 pt-3 pb-6 space-y-2 shadow-lg animate-in fade-in duration-200">
    {navLinks.map((link) => {
      const isActive = link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href);
      return (
        <a
          href={link.href}
          class={`block px-4 py-3 rounded-2xl text-base font-semibold transition-colors ${
            isActive
              ? 'text-brand-primary bg-brand-secondary/70'
              : 'text-brand-text hover:bg-brand-secondary/30'
          }`}
        >
          {link.name}
        </a>
      );
    })}
    <div class="pt-3">
      <a
        href="/#cta-section"
        class="w-full text-center block px-5 py-3 rounded-2xl font-bold text-base text-brand-text bg-brand-accent hover:bg-[#FFA84D] shadow-warm transition-transform active:scale-95"
      >
        Pilih MPASI Sehat untuk Si Kecil
      </a>
    </div>
  </div>
</header>

<script>
  // Script interaktif untuk toggle menu mobile
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (btn && menu && hamburgerIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Close menu when clicking outside
    document.addEventListener('click', (event) => {
      if (!btn.contains(event.target as Node) && !menu.contains(event.target as Node) && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
