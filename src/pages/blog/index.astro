---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getDatabase } from '../../lib/notion';

// Ambil seluruh artikel yang dipublish di Notion
const allPosts = await getDatabase();

const breadcrumbItems = [
  { name: 'Blog & Panduan MPASI', url: '/blog' },
];

const topicsList = [
  'Semua Topik',
  'Panduan MPASI sesuai usia',
  'MPASI Sehat & Tumbuh Kembang Bayi',
  'Ide menu MPASI',
  'Nutrisi dan kebutuhan bayi',
  'Tips memilih bahan makanan',
  'Resep MPASI praktis',
  'Tips menghadapi GTM (Gerakan Tutup Mulut)',
  'Tips menyimpan dan menyiapkan MPASI',
];
---

<Layout
  title="Blog & Panduan MPASI Sehat, Resep, dan Tumbuh Kembang Bayi"
  description="Kumpulan panduan MPASI terpercaya, resep harian kaya zat besi, tips mengatasi GTM, dan jadwal makan bayi usia 6-24 bulan."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Page Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-4">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold bg-brand-primary/10 text-brand-primary">
        Koleksi Edukasi Nutrisi & Resep
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-heading text-brand-text">
        Panduan & Resep MPASI Terpercaya
      </h1>
      <p class="text-base sm:text-lg text-brand-text-muted leading-relaxed">
        Temukan artikel berbasis medis dan ide menu praktis untuk mendampingi si kecil tumbuh sehat, cerdas, dan lahap makan.
      </p>

      <!-- Client-side Search Input -->
      <div class="pt-4 max-w-md mx-auto">
        <div class="relative">
          <input
            type="search"
            id="blog-search"
            placeholder="Cari resep, menu 6 bulan, tips GTM..."
            class="w-full px-5 py-3.5 pl-12 rounded-full border border-brand-border bg-white text-brand-text text-sm focus:outline-none focus:ring-2 focus:ring-brand-primary shadow-sm placeholder:text-brand-text-muted/60"
          />
          <svg class="w-5 h-5 text-brand-primary absolute left-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-10 scrollbar-none justify-start md:justify-center">
      {topicsList.map((topic, idx) => (
        <button
          type="button"
          class={`filter-tab px-4 py-2 rounded-full text-xs sm:text-sm font-semibold whitespace-nowrap transition-all duration-200 ${
            idx === 0
              ? 'bg-brand-primary text-white shadow-soft active-tab'
              : 'bg-white text-brand-text hover:bg-brand-secondary/60 border border-brand-border'
          }`}
          data-tag={topic === 'Semua Topik' ? 'all' : topic}
        >
          {topic}
        </button>
      ))}
    </div>

    <!-- Posts Grid -->
    <div id="posts-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {allPosts.map((post) => (
        <div
          class="post-item"
          data-title={post.title.toLowerCase()}
          data-excerpt={post.excerpt.toLowerCase()}
          data-tags={JSON.stringify(post.tags.map(t => t.name.toLowerCase()))}
        >
          <BlogCard post={post} />
        </div>
      ))}
    </div>

    <!-- Empty State for Search / Filter -->
    <div id="empty-state" class="hidden text-center py-16 bg-white rounded-4xl border border-brand-border mt-8 p-8">
      <div class="w-16 h-16 rounded-3xl bg-brand-secondary flex items-center justify-center text-3xl mx-auto mb-4">
        🔍
      </div>
      <h3 class="text-xl font-bold font-heading text-brand-text mb-2">
        Artikel tidak ditemukan
      </h3>
      <p class="text-sm text-brand-text-muted max-w-sm mx-auto mb-6">
        Coba gunakan kata kunci lain seperti "GTM", "puree", atau "kaldu", atau reset filter topik.
      </p>
      <button
        type="button"
        id="reset-filter-btn"
        class="px-6 py-2.5 rounded-full font-bold text-xs bg-brand-primary text-white hover:bg-brand-primary-dark transition-colors"
      >
        Tampilkan Semua Artikel
      </button>
    </div>

  </div>
</Layout>

<script>
  // Client-side instant filter & search logic
  const searchInput = document.getElementById('blog-search') as HTMLInputElement | null;
  const filterTabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const postItems = document.querySelectorAll<HTMLElement>('.post-item');
  const emptyState = document.getElementById('empty-state');
  const resetBtn = document.getElementById('reset-filter-btn');

  let currentTag = 'all';
  let searchQuery = '';

  // Check URL query parameters (e.g. ?tag=Tips+GTM)
  const urlParams = new URLSearchParams(window.location.search);
  const tagParam = urlParams.get('tag');
  if (tagParam) {
    currentTag = tagParam;
    filterTabs.forEach((tab) => {
      if (tab.getAttribute('data-tag') === tagParam) {
        setActiveTab(tab);
      }
    });
  }

  function setActiveTab(activeButton: HTMLButtonElement) {
    filterTabs.forEach((tab) => {
      tab.classList.remove('bg-brand-primary', 'text-white', 'shadow-soft', 'active-tab');
      tab.classList.add('bg-white', 'text-brand-text', 'border', 'border-brand-border');
    });
    activeButton.classList.add('bg-brand-primary', 'text-white', 'shadow-soft', 'active-tab');
    activeButton.classList.remove('bg-white', 'text-brand-text', 'border-brand-border');
  }

  function filterPosts() {
    let visibleCount = 0;

    postItems.forEach((item) => {
      const title = item.getAttribute('data-title') || '';
      const excerpt = item.getAttribute('data-excerpt') || '';
      const tags = JSON.parse(item.getAttribute('data-tags') || '[]');

      const matchesSearch = !searchQuery || title.includes(searchQuery) || excerpt.includes(searchQuery);
      const matchesTag = currentTag === 'all' || tags.some((t: string) => t.toLowerCase() === currentTag.toLowerCase());

      if (matchesSearch && matchesTag) {
        item.style.display = 'block';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }
  }

  // Handle Search Input
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterPosts();
    });
  }

  // Handle Filter Tabs
  filterTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const tag = tab.getAttribute('data-tag') || 'all';
      currentTag = tag;
      setActiveTab(tab);
      filterPosts();
    });
  });

  // Handle Reset Button
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      currentTag = 'all';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      const firstTab = document.querySelector<HTMLButtonElement>('.filter-tab[data-tag="all"]');
      if (firstTab) setActiveTab(firstTab);
      filterPosts();
    });
  }

  // Initial trigger
  filterPosts();
</script>
