---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BlogCard from '../components/BlogCard.astro';
import { getDatabase } from '../lib/notion';

// Ambil postingan blog dari Notion (3 postingan teratas)
const allPosts = await getDatabase();
const recentPosts = allPosts.slice(0, 3);

// 3 Fitur Unggulan (Why Choose Us)
const features = [
  {
    title: 'Nutrisi Teruji & Ahli Gizi',
    description: 'Diformulasikan sesuai anjuran IDAI & WHO dengan komposisi gizi makro serta mikro seimbang kaya zat besi (iron-rich) untuk optimalkan kecerdasan otak.',
    icon: 'scale',
    badge: 'Formula Medis',
    color: 'bg-brand-primary/10 text-brand-primary',
  },
  {
    title: 'Praktis, Siap Saji 5 Menit',
    description: 'Solusi cerdas bagi Mama aktif! Tanpa repot belanja & potong bahan berjam-jam di dapur, menu sehat higienis siap disantap si kecil kapan saja.',
    icon: 'clock',
    badge: 'Hemat Waktu',
    color: 'bg-brand-accent/20 text-brand-accent',
  },
  {
    title: '100% Bahan Alami Tanpa Pengawet',
    description: 'Bahan segar pilihan dari peternakan & kebun organik lokal. Bebas 3P (Pengawet, Pewarna, Perasa buatan), no added salt, no MSG.',
    icon: 'shield',
    badge: '100% Aman',
    color: 'bg-brand-coral/20 text-brand-coral',
  },
];

// Kategori Menu Sesuai Usia
const ageCategories = [
  {
    stage: 'Usia 6–8 Bulan',
    title: 'Tahap Pengenalan Rasa (Puree Halus)',
    desc: 'Tekstur saring halus kental untuk melatih refleks telan awal dan penuhi kebutuhan zat besi esensial.',
    icon: '🥣',
    items: ['Puree Hati Ayam Gurih', 'Bubur Daging Sapi Labu', 'Puree Alpukat ASI Lembut'],
  },
  {
    stage: 'Usia 9–11 Bulan',
    title: 'Tahap Stimulasi Mengunyah (Mashed & Cincang)',
    desc: 'Tekstur naik bertahap dengan cacahan lembut untuk merangsang pertumbuhan gigi dan oromotor bayi.',
    icon: '🍲',
    items: ['Nasi Tim Ikan Salmon', 'Sup Makaroni Telur Puyuh', 'Bubur Semur Daging Wortel'],
  },
  {
    stage: 'Usia 12–24 Bulan',
    title: 'Tahap Menu Keluarga & Finger Foods',
    desc: 'Kaya tekstur dan bentuk mandiri (self-feeding) untuk melatih koordinasi motorik halus tangan dan mulut.',
    icon: '🥦',
    items: ['Nugget Tempe Ayam Kukus', 'Meatball Brokoli Keju', 'Pancake Pisang Oat Sehat'],
  },
];
---

<Layout
  title="NutriMPASI - Brand Website & Digital Media MPASI Sehat Bayi"
  description="Solusi MPASI sehat, praktis, bergizi, dan aman untuk bayi usia 6-24 bulan. Dilengkapi ratusan panduan gizi dan resep anti GTM."
>
  <!-- 1. Hero Section -->
  <Hero />

  <!-- 2. Section: Why Choose Us (Fitur Unggulan) -->
  <section class="py-16 md:py-24 bg-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold bg-brand-secondary text-brand-primary">
          Mengapa Ribuan Ibu Mempercayai Kami?
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-brand-text">
          Standar Kualitas Tertinggi untuk Kesehatan Buah Hati Anda
        </h2>
        <p class="text-base sm:text-lg text-brand-text-muted leading-relaxed">
          Kami memahami betapa berharganya setiap suapan untuk masa depan anak. Seluruh produk & edukasi dirancang dengan standar kebersihan dan keamanan ketat.
        </p>
      </div>

      <!-- Features Grid (3 Poin Utama) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {features.map((feature) => (
          <div class="p-8 rounded-4xl bg-brand-bg border border-brand-border/80 hover:shadow-soft-hover hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class={`w-14 h-14 rounded-2xl ${feature.color} flex items-center justify-center`}>
                  {feature.icon === 'scale' && (
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path>
                    </svg>
                  )}
                  {feature.icon === 'clock' && (
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  )}
                  {feature.icon === 'shield' && (
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                  )}
                </div>
                <span class="text-xs font-bold px-3 py-1 rounded-full bg-white border border-brand-border text-brand-text-muted">
                  {feature.badge}
                </span>
              </div>

              <h3 class="text-xl font-bold font-heading text-brand-text mb-3 group-hover:text-brand-primary transition-colors">
                {feature.title}
              </h3>
              <p class="text-brand-text-muted text-sm sm:text-base leading-relaxed">
                {feature.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-brand-border/60 flex items-center text-xs font-bold text-brand-primary">
              <span>Sesuai Rekomendasi Medis</span>
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 3. Section: Varian Menu MPASI Sesuai Usia Bayi -->
  <section id="produk-section" class="py-16 md:py-24 bg-brand-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold bg-brand-accent/20 text-brand-accent">
          Menu Tepat Sesuai Usia
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-brand-text">
          Panduan Menu & Produk MPASI NutriMPASI
        </h2>
        <p class="text-base sm:text-lg text-brand-text-muted leading-relaxed">
          Setiap tahapan usia membutuhkan stimulasi tekstur yang berbeda untuk mencegah keterlambatan bicara (speech delay) dan cegah GTM.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {ageCategories.map((cat) => (
          <div class="p-8 rounded-4xl bg-white border border-brand-border/80 shadow-soft flex flex-col justify-between">
            <div>
              <div class="text-4xl mb-4">{cat.icon}</div>
              <span class="inline-block px-3 py-1 rounded-full text-xs font-extrabold bg-brand-secondary text-brand-primary mb-3">
                {cat.stage}
              </span>
              <h3 class="text-xl font-bold font-heading text-brand-text mb-3">
                {cat.title}
              </h3>
              <p class="text-sm text-brand-text-muted leading-relaxed mb-6">
                {cat.desc}
              </p>

              <div class="space-y-2 mb-6">
                <p class="text-xs font-bold text-brand-text uppercase tracking-wider">Contoh Varian Menu:</p>
                {cat.items.map((item) => (
                  <div class="flex items-center gap-2 text-sm text-brand-text/90">
                    <svg class="w-4 h-4 text-brand-primary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    <span>{item}</span>
                  </div>
                ))}
              </div>
            </div>

            <a
              href="#cta-section"
              class="w-full text-center py-3 rounded-full font-bold text-sm bg-brand-bg hover:bg-brand-secondary text-brand-primary border border-brand-border transition-colors block"
            >
              Konsultasi Menu Usia Ini
            </a>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 4. Section: Blog & Resep Terbaru (Notion CMS) -->
  <section class="py-16 md:py-24 bg-white border-t border-brand-border/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header with "Lihat Semua" link -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div class="space-y-3">
          <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold bg-brand-primary/10 text-brand-primary">
            Edukasi & Resep Notion CMS
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-brand-text">
            Artikel & Panduan MPASI Terbaru
          </h2>
          <p class="text-brand-text-muted text-base max-w-xl">
            Tips praktis dari dokter spesialis anak dan ahli gizi untuk mendampingi setiap tahapan makan buah hati.
          </p>
        </div>

        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-bold text-sm text-brand-primary bg-brand-secondary/60 hover:bg-brand-secondary transition-colors"
        >
          <span>Lihat Semua Artikel ({allPosts.length})</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>

      <!-- Posts Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>

    </div>
  </section>

  <!-- 5. Section: FAQ Singkat Seputar MPASI -->
  <section id="faq-section" class="py-16 md:py-24 bg-brand-bg">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 space-y-3">
        <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold bg-brand-secondary text-brand-primary">
          Pertanyaan Sering Diajukan
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-brand-text">
          Tanya Jawab Seputar MPASI
        </h2>
      </div>

      <div class="space-y-4">
        <details class="p-6 rounded-3xl bg-white border border-brand-border shadow-sm group">
          <summary class="font-bold text-lg text-brand-text cursor-pointer list-none flex justify-between items-center">
            <span>Kapan waktu yang paling tepat memulai MPASI?</span>
            <span class="text-brand-primary group-open:rotate-180 transition-transform font-bold text-xl">↓</span>
          </summary>
          <p class="mt-4 text-brand-text-muted text-sm sm:text-base leading-relaxed">
            Sesuai rekomendasi IDAI dan WHO, MPASI dimulai tepat saat bayi berusia 6 bulan (180 hari) jika tanda kesiapan fisik seperti leher tegak dan ketertarikan makan sudah muncul.
          </p>
        </details>

        <details class="p-6 rounded-3xl bg-white border border-brand-border shadow-sm group">
          <summary class="font-bold text-lg text-brand-text cursor-pointer list-none flex justify-between items-center">
            <span>Bagaimana jika anak tiba-tiba GTM (Gerakan Tutup Mulut)?</span>
            <span class="text-brand-primary group-open:rotate-180 transition-transform font-bold text-xl">↓</span>
          </summary>
          <p class="mt-4 text-brand-text-muted text-sm sm:text-base leading-relaxed">
            Evaluasi feeding rules: batasi waktu makan maksimal 30 menit, jangan paksa anak, ciptakan suasana tanpa distraksi (gadget/mainan), dan periksa apakah bayi sedang tumbuh gigi atau bosan dengan variasi tekstur.
          </p>
        </details>

        <details class="p-6 rounded-3xl bg-white border border-brand-border shadow-sm group">
          <summary class="font-bold text-lg text-brand-text cursor-pointer list-none flex justify-between items-center">
            <span>Apakah MPASI harus menggunakan slow cooker?</span>
            <span class="text-brand-primary group-open:rotate-180 transition-transform font-bold text-xl">↓</span>
          </summary>
          <p class="mt-4 text-brand-text-muted text-sm sm:text-base leading-relaxed">
            Tidak harus! Mama bisa memasak menggunakan panci biasa di kompor atau memanfaatkan produk siap olah higienis dari NutriMPASI yang telah dikemas dalam takaran porsi harian bernutrisi.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- 6. Section: CTA Utama [CTA_UTAMA] -->
  <section id="cta-section" class="py-20 md:py-28 bg-gradient-to-br from-brand-primary via-[#41b0bb] to-[#349fa9] text-white relative overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute -right-20 -top-20 w-80 h-80 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
    <div class="absolute -left-20 -bottom-20 w-80 h-80 rounded-full bg-brand-accent/20 blur-2xl pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-8">
      
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/20 backdrop-blur-sm text-xs sm:text-sm font-semibold text-brand-secondary">
        <span>👶 Nutrisi Terbaik untuk Periode Emas Si Kecil</span>
      </div>

      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold font-heading text-white leading-tight">
        Siap Memberikan Nutrisi Terbaik Tanpa Ribet?
      </h2>

      <p class="text-base sm:text-lg md:text-xl text-white/90 max-w-2xl mx-auto leading-relaxed">
        Dapatkan paket menu MPASI sehat, praktis, bergizi, dan aman untuk si kecil. Konsultasikan usia anak Anda dan dapatkan menu rekomendasi hari ini.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="https://wa.me/6281234567890?text=Halo%20NutriMPASI,%20saya%20ingin%20memilih%20menu%20MPASI%20sehat%20untuk%20si%20kecil"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-9 py-5 rounded-full font-extrabold text-base sm:text-lg text-brand-text bg-brand-accent hover:bg-[#FFA84D] shadow-2xl transition-all duration-200 hover:-translate-y-1 active:translate-y-0"
        >
          <svg class="w-6 h-6 text-brand-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Pilih MPASI Sehat untuk Si Kecil</span>
        </a>

        <a
          href="/blog"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-5 rounded-full font-bold text-base sm:text-lg text-white bg-white/15 hover:bg-white/25 border border-white/30 backdrop-blur-sm transition-all duration-200"
        >
          <span>Lihat Katalog Resep</span>
        </a>
      </div>

      <p class="text-xs text-white/70">
        Konsultasi ramah via WhatsApp • Pengiriman higienis berpendingin • Jaminan kesegaran 100%
      </p>

    </div>
  </section>
</Layout>
